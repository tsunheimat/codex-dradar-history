[Unit]
Description=dradar2 upstream collector (long-term codexradar archive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dradar2
# Adjust WorkingDirectory to the repo checkout, e.g.:
#   /mnt/vibe-coding-share/develop/codex-dradar2
ExecStart=/usr/bin/env node src/collector.js
Environment=DATA_DIR=./data
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
