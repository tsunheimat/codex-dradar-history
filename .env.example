# dradar2 configuration (all optional — defaults shown)

# Docker Compose image (use a v* or sha-* tag to pin a release)
DRADAR2_IMAGE=ghcr.io/tsunheimat/codex-dradar-history:latest

# Web server
PORT=3210
BIND=0.0.0.0

# Where archive.sqlite lives
DATA_DIR=./data

# Collector politeness
USER_AGENT=dradar2/1.0 (+personal long-term archive of codexradar.com)
MAX_RESPONSE_MB=8
RUNS_KEEP_DAYS=30
# Multiply every feed interval (2.0 = poll half as often)
INTERVAL_SCALE=1.0
# Per-feed overrides, JSON: {"deng:table": 1200, "codex:html": 900}
FEED_INTERVALS=
